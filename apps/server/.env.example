# Copy to .env for local runs only. In production use `fly secrets set` / fly.toml [env].
# Nothing real belongs in this file.

PORT=8080
HOST=0.0.0.0

# Comma separated exact origins allowed to open a WebSocket (no trailing slash, no "*").
# Unset means every upgrade is refused.
ALLOWED_ORIGINS=https://your-app.vercel.app

# Set to 1 only behind Fly's proxy, so per-IP limits read Fly-Client-IP.
TRUST_PROXY=0

# Optional limits (positive integers). Defaults shown.
# MAX_ROOMS_PER_IP=30     # live rooms one IP may own at once
# MAX_CONNS_PER_IP=100    # open sockets per IP
# MAX_ROOMS=1000          # live rooms in total (memory bound)
# FINISHED_ROOM_MS=120000 # how long a room lives after its game ends
